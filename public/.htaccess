# Gerado a partir do mapa de redirects (vercel.json + sitemap antigo). Hostinger / Apache.
RewriteEngine On

# 0) /index e /index.html -> /
RewriteRule ^index(\.html)?$ / [R=301,L]

# 1) /pagina.html -> /pagina (301)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) remove barra final (exceto pastas reais)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 3) serve /pagina a partir de pagina.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

ErrorDocument 404 /404.html

# URLs antigas (WordPress) -> novas
