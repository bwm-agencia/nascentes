---
interface Props {
  title: string;
  headExtra?: string;
  script?: string;
}
const { title, headExtra = '', script } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<Fragment set:html={headExtra} />
</head>
<body>
<slot />
{script && <script is:inline src={script} defer></script>}
</body>
</html>
