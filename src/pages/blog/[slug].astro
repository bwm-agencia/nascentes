---
import Layout from '../../layouts/Layout.astro';
import Menu from '../../components/Menu.astro';
import Footer from '../../components/Footer.astro';
import { DocumentRenderer } from '@keystatic/core/renderer';
import '../../styles/blog.css';
import { listPosts, img, wa } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await listPosts();
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
const { reader } = await import('../../lib/content');
const post = (await reader.collections.posts.read(slug))!;
const corpo = await post.corpo();
const foto = img(post.foto);
const titulo = post.titulo;
const pageTitle = post.metaTitulo;
const ogImg = img(post.imagemCompartilhamento) || foto;
const faqLd = post.perguntas.length ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: post.perguntas.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })) }) : '';
const head =
  `<meta name="description" content="${post.metaDescricao.replace(/"/g, '&quot;')}">\n` +
  `<meta property="og:image" content="${ogImg}">\n` +
  `<meta property="article:published_time" content="${post.data}">` +
  (post.atualizadoEm ? `\n<meta property="article:modified_time" content="${post.atualizadoEm}">` : '') +
  (post.semIndexar ? '\n<meta name="robots" content="noindex">' : '');
const outros = (await listPosts()).filter((p) => p.slug !== slug).slice(0, 3);
---
<Layout title={pageTitle} headExtra={head} script="/js/blog.js">
<Menu active="/blog" />

<section class="ar-hero">
  <div class="photo" style={`background-image:url('${foto}');`} role="img" aria-label={post.fotoAlt}></div>
  <div class="inner">
    <a class="back" href="/blog">← Voltar para o Guia de Brotas</a>
    <div class="bl-meta"><span class="cat">{post.categoria}</span></div>
    <h1>{titulo}</h1>
  </div>
</section>
<article class="ar-body">
  <div class="content">
    <DocumentRenderer document={corpo} />
    {post.perguntas.length > 0 && (
      <section class="ar-faq" style="margin-top:48px;">
        <h2>Perguntas frequentes</h2>
        {post.perguntas.map((f) => <details style="margin:12px 0;"><summary style="cursor:pointer;font-weight:600;">{f.pergunta}</summary><p>{f.resposta}</p></details>)}
        <script type="application/ld+json" set:html={faqLd}></script>
      </section>
    )}
  </div>
  <div class="ar-cta reveal">
    <div><p class="eyebrow">Pousada das Nascentes</p><h2>Vem viver Brotas com a gente</h2><p>Suítes temáticas com hidromassagem ou ofurô, no Circuito das Cachoeiras.</p></div>
    <div class="btns"><a class="cta-glow cta-glow--small" href={wa('Olá! Vim pelo Guia de Brotas e gostaria de consultar valores e disponibilidade.')} target="_blank" rel="noopener">Reservar no WhatsApp</a></div>
  </div>
</article>
{outros.length > 0 && (
<section class="ar-more">
  <div class="suite-section-head reveal"><p class="eyebrow">Continue lendo</p><h2>Outras novidades</h2></div>
  <div class="bl-grid">
    {outros.map((o) => (
      <a class="bl-card reveal" href={`/blog/${o.slug}`} data-cat="">
        <div class="thumb"><img src={img(o.entry.foto)} alt={o.entry.titulo} loading="lazy" /></div>
        <div class="body"><div class="bl-meta"><span class="cat">{o.entry.categoria}</span></div><h2>{o.entry.titulo}</h2><p>{o.entry.resumo}</p><span class="more">Ler artigo →</span></div>
      </a>
    ))}
  </div>
</section>
)}
<Footer />
</Layout>
