---
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
import FooterHome from '../components/FooterHome.astro';
import '../styles/index.css';
---
<Layout title={"Pousada das Nascentes — À beira do rio, depois do anoitecer"} script="/js/index.js">
<Menu logoHref="#top" />

<section class="hero" id="top">
  <div class="hero-photo" style="background-image:url('/fotos-hero/foto-05.jpg');"></div>
  <div class="glow-orb"></div>
  <div class="hero-copy">
    <p class="eyebrow reveal in">Brotas · à beira do rio</p>
    <h1 class="reveal in">Onde a <em class="glow">água nasce</em><br>e a noite <em class="rose">desacelera</em></h1>
    <p class="reveal in">Dezoito suítes com hidromassagem ou ofurô cromoterápico, cercadas pelas cachoeiras de Brotas. Chegamos de dia — mas é depois do anoitecer que a Nascentes se revela.</p>
    <div class="hero-actions reveal in">
      <a class="cta-glow" href="https://api.whatsapp.com/send?phone=5514991797722&text=Olá! Gostaria de consultar valores e disponibilidade." target="_blank" rel="noopener">Reservar a nossa noite</a>
      <a class="link-glow" href="/suites.html">Ver suítes <span class="arrow">→</span></a>
    </div>
  </div>
  <div class="scroll-hint"><span>Role</span><span class="line"></span></div>
</section>

<section class="availability-wrap">
  <div class="availability-card reveal in">
    <p class="avail-title">Verifique disponibilidade</p>
    <div class="avail-row">
      <div class="avail-fields">
        <button type="button" class="avail-field" id="checkin-field" data-target="in" aria-haspopup="dialog" aria-expanded="false">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
          <span class="avail-text"><small>Check-in</small><span class="avail-label" id="checkin-label">Data de Entrada</span></span>
        </button>
        <button type="button" class="avail-field" id="checkout-field" data-target="out" aria-haspopup="dialog" aria-expanded="false">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
          <span class="avail-text"><small>Check-out</small><span class="avail-label" id="checkout-label">Data de Saída</span></span>
        </button>
      </div>
      <button type="button" class="avail-submit" id="avail-submit">Continuar</button>
    </div>
    <div class="cal-pop" id="cal-pop" role="dialog" aria-label="Escolha as datas" hidden>
      <div class="cal-head">
        <button type="button" class="cal-nav" id="cal-prev" aria-label="Mês anterior"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
        <p class="cal-hint" id="cal-hint">Escolha a data de entrada</p>
        <button type="button" class="cal-nav" id="cal-next" aria-label="Próximo mês"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
      <div class="cal-months" id="cal-months"></div>
      <div class="cal-foot">
        <span id="cal-summary"></span>
        <div><button type="button" class="cal-clear" id="cal-clear">Limpar</button><button type="button" class="cal-ok" id="cal-ok">Confirmar</button></div>
      </div>
    </div>
    <p class="avail-msg" id="avail-msg" hidden></p>
    <p class="avail-footer">Atendimento via WhatsApp · (14) 99179-7722</p>
  </div>
</section>

<section class="intro-title-section">
  <div class="intro-title-inner reveal">
