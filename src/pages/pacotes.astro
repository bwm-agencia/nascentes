<section class="final-cta">
  <div class="photo" style="background-image:url('/fotos-hero/foto-04.jpg'); background-position:center 25%;"></div>
  <div class="final-cta-inner reveal">
    <p class="eyebrow">Pronta para escolher?</p>
    <h2>Falta só um passo<br><span class="accent">para reservar o seu</span></h2>
    <p class="sub">Fale com a gente pelo WhatsApp e garanta o pacote ideal — as datas especiais têm vagas limitadas.</p>
    <div class="actions">
      <a class="btn-whatsapp" href="https://api.whatsapp.com/send?phone=5514991797722&text=Ol%C3%A1%21%20Gostaria%20de%20saber%20qual%20pacote%20combina%20melhor%20com%20a%20nossa%20viagem." target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1l-2.3 2.3z"/></svg>Falar no WhatsApp</a>
      <a class="btn-outline" href="/suites.html">Ver as suítes</a>
    </div>
  </div>
</section>
<Footer />
<div class="suite-modal-overlay" id="suite-modal-overlay">
  <div class="suite-modal">
    <button class="suite-modal-close" type="button" aria-label="Fechar">&times;</button>
    <div class="modal-img">
      <img id="suite-modal-img" src="" alt="">
    </div>
    <div class="suite-modal-body">
      <p class="amenity" id="suite-modal-amenity"></p>
      <h3 id="suite-modal-name"></h3>
      <span class="slogan" id="suite-modal-slogan"></span>
      <p class="desc" id="suite-modal-desc"></p>
      <a class="cta-glow" id="suite-modal-book" href="#" target="_blank" rel="noopener">Reservar no WhatsApp</a>
    </div>
  </div>
</div>
</Layout>
