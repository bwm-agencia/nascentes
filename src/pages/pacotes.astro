---
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import '../styles/pacotes.css';
---
<Layout title={"Pacotes para Brotas — Pousada das Nascentes"} script="/js/pacotes.js">
<Menu active="/pacotes.html" /><section class="subhero" id="top">
  <div class="subhero-photo" style="background-image:url('/fotos-casais/topo-pacotes.jpg'); background-position:center 62%;"></div>
  <div class="subhero-copy">
    <p class="eyebrow reveal in">Pacotes para Brotas</p>
    <h1 class="reveal in">Escolha o <em style="font-style:italic;color:var(--amber-soft);">roteiro</em><br>perfeito para vocês</h1>
    <p class="reveal in">Combinações completas de suíte, café da manhã e mimos especiais — para quem já sabe a data, e para quem só precisa de um empurrãozinho para decidir.</p>
  </div>
</section>

<section class="suite-section" style="background:var(--wine);">
  <div class="suite-section-head reveal">
    <p class="eyebrow">Pacotes românticos</p>
    <h2>Uma combinação perfeita para o seu momento</h2>
    <p>Preparamos excelentes alternativas para curtir Brotas — do jeito de sempre ou em datas especiais. Fale com a gente e complete seu pacote com opcionais.</p>
  </div>
  <div class="package-grid">
    <div class="package-card reveal package-card--featured">
      <div class="photo" style="background-image:url('/fotos-casais/pousada-das-nascentes-ia-3.jpg'); background-position:center 55%;"></div>
