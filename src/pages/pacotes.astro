          <a class="btn-book" href="https://api.whatsapp.com/send?phone=5514991797722&text=Ol%C3%A1%21%20Gostaria%20de%20saber%20mais%20sobre%20o%20pacote%20de%2012%20de%20Outubro." target="_blank" rel="noopener">Reservar</a>
          <a class="btn-details" href="/pacotes/12-de-outubro.html">Detalhes</a>
        </div>
      </div>
    </div>
    <div class="package-card reveal">
      <div class="photo" style="background-image:url('/fotos-casais/pousada-das-nascentes-ia-9.jpg'); background-position:center 60%;"></div>
      <div class="body">
        <p class="eyebrow">De 30/10 a 02/11</p>
        <h3><a href="/pacotes/feriado-2-de-novembro.html">Feriado 2 de Novembro</a></h3>
        <ul>
        <li><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>Suítes com Hidromassagem</li>
        <li><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>Suítes com Ofurô Cromoterápico</li>
        <li><svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>Café da manhã completo</li>
        </ul>
        <div class="actions">
          <a class="btn-book" href="https://api.whatsapp.com/send?phone=5514991797722&text=Ol%C3%A1%21%20Gostaria%20de%20saber%20mais%20sobre%20o%20pacote%20do%20Feriado%20de%202%20de%20Novembro." target="_blank" rel="noopener">Reservar</a>
