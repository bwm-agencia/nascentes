        </ul>
        <div class="actions">
          <a class="btn-book" href="https://api.whatsapp.com/send?phone=5514991797722&text=Ol%C3%A1%21%20Gostaria%20de%20saber%20mais%20sobre%20o%20pacote%20Primavera%20Rom%C3%A2ntica%20%28Fique%203%2C%20pague%202%29." target="_blank" rel="noopener">Reservar</a>
